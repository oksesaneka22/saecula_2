[gd_resource type="Resource" script_class="RecipeData" load_steps=6 format=3 uid="uid://saecula_recipe_copper_ingot"]

[ext_resource type="Script" path="res://src/data/schemas/RecipeData.gd" id="1_recipe"]
[ext_resource type="Script" path="res://src/data/schemas/ItemCost.gd" id="2_cost"]
[ext_resource type="Resource" path="res://data/items/copper_ore.tres" id="3_ore"]
[ext_resource type="Resource" path="res://data/items/wood.tres" id="4_wood"]
[ext_resource type="Resource" path="res://data/items/copper_ingot.tres" id="5_ingot"]

[sub_resource type="Resource" id="Cost_ore"]
script = ExtResource("2_cost")
