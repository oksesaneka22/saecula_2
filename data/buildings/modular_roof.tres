[gd_resource type="Resource" script_class="BuildingData" load_steps=5 format=3 uid="uid://saecula_bld_modular_roof"]

[ext_resource type="Script" path="res://src/data/schemas/BuildingData.gd" id="1_bld"]
[ext_resource type="Script" path="res://src/data/schemas/ItemCost.gd" id="2_cost"]
[ext_resource type="Resource" path="res://data/items/wood.tres" id="3_wood"]
[ext_resource type="Resource" path="res://data/items/straw.tres" id="4_straw"]

[sub_resource type="Resource" id="Cost_wood"]
script = ExtResource("2_cost")
item = ExtResource("3_wood")
amount = 1

[sub_resource type="Resource" id="Cost_straw"]
script = ExtResource("2_cost")
item = ExtResource("4_straw")
amount = 2

[resource]
script = ExtResource("1_bld")
id = &"modular_roof"
display_name = "Стеля (сіно)"
description = "Стеля та покрівля із сіна (1x1м). Потребує наявності стін або опор для підтримки."
size_in_tiles = Vector2i(1, 1)
